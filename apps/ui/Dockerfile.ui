FROM node:22-alpine AS builder
WORKDIR /app
# corepack takes the pnpm version from `packageManager` in package.json, which is the
# same version .github/workflows/ci.yml resolves (pnpm/action-setup reads the same
# field) — so the lockfile is validated by the resolver that wrote it. The prompt would
# otherwise block the build waiting for a TTY that a `docker build` does not have.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
COPY package.json pnpm-lock.yaml .npmrc pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --config.minimum-release-age=0
COPY . .
ARG VITE_FIBER_API_URL=http://localhost:18080
ENV VITE_FIBER_API_URL=$VITE_FIBER_API_URL
RUN pnpm build && \
  if [ -d dist/client ]; then \
    echo "using dist/client"; \
  elif [ -d dist ]; then \
    mkdir -p /tmp/out && cp -a dist/. /tmp/out/ && rm -rf dist && mkdir -p dist/client && cp -a /tmp/out/. dist/client/; \
  elif [ -d .output/public ]; then \
    mkdir -p dist/client && cp -a .output/public/. dist/client/; \
  else \
    echo "unknown build output:" && find . -maxdepth 3 -type d | head -40 && exit 1; \
  fi

# nginx-unprivileged, not nginx: the stock image starts as root to bind :80 and only
# then drops to the `nginx` user, so a container escape starts from uid 0. This one runs
# as uid 101 from PID 1 and listens on 8080 (see nginx.conf), which is also what lets
# deploy/docker-compose.yml give it `read_only: true` and drop every capability —
# without CAP_NET_BIND_SERVICE nothing can bind a privileged port anyway.
FROM nginxinc/nginx-unprivileged:1.29-alpine
COPY --from=builder /app/dist/client /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
# busybox wget, not curl: the image ships no curl and adding one would mean a package
# manager run as a non-root user.
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1

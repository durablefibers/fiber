# Copy to deploy/.env (git-ignored). Compose reads it automatically.
# Generate the secrets key once and back it up: encrypted secrets are lost without it.
FIBER_SECRETS_KEY=
# Bootstrap admin — applied only on the FIRST boot of an empty database. To rotate an
# existing admin password, change it through the API/UI; this value is then ignored.
FIBER_ADMIN_USER=admin
FIBER_ADMIN_PASSWORD=
# Applied when the Postgres volume is first initialised.
FIBER_POSTGRES_PASSWORD=fiber
FIBER_REDIS_PASSWORD=fiber
FIBER_S3_ACCESS_KEY=fiber
FIBER_S3_SECRET_KEY=fiberfiber
# Host agents/browsers use to reach MinIO for presigned artifact URLs.
FIBER_S3_PUBLIC_ENDPOINT=http://127.0.0.1:19000
# Browser origins allowed to call the API (comma-separated). `*` allows any origin.
FIBER_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# Interface the API / web ports bind to on the host. 127.0.0.1 = reverse proxy only.
FIBER_API_BIND=127.0.0.1
FIBER_WEB_BIND=127.0.0.1
# Worker started by `docker compose --profile agent up -d fiber-agent`.
# Create the token first: fiber agents create --name compose --labels os=linux
FIBER_AGENT_TOKEN=
FIBER_AGENT_NAME=compose
FIBER_AGENT_LABELS=os=linux
FIBER_AGENT_CONCURRENCY=2

# API URL baked into the web bundle at build time.
VITE_FIBER_API_URL=http://localhost:18080
RUST_LOG=info,fiber_api=info

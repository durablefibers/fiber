# Fiber Compose settings.  cp deploy/.env.example deploy/.env  and fill the four
# credentials below — `docker compose config` fails until they are set.
# Everything else is optional; an empty value means "use the API's own default"
# (docs/configuration.md lists them all).
#
# This file is read by `docker compose -f deploy/docker-compose.yml` automatically
# because it sits next to the Compose file. Keep deploy/.env out of git (it is ignored)
# and off any image — the root .dockerignore is an allowlist so it cannot be copied in.

# ---------------------------------------------------------------- required credentials
# Postgres superuser password. Applied when the fiber_pg volume is first initialised;
# changing it afterwards needs `ALTER ROLE fiber PASSWORD ...` inside the container.
FIBER_POSTGRES_PASSWORD=

# Redis `requirepass`. Reaches the server through a Compose config file, not argv.
FIBER_REDIS_PASSWORD=

# MinIO root credentials, and the credentials fiber-api signs S3 requests with.
# Required even if you never start the `minio` profile: Compose interpolates the whole
# file before it filters by profile, and an empty MINIO_ROOT_USER would let MinIO fall
# back to minioadmin/minioadmin. Any non-empty placeholder is fine when
# FIBER_S3_BUCKET is empty, since nothing reads them then.
FIBER_S3_ACCESS_KEY=
FIBER_S3_SECRET_KEY=

# Bootstrap admin password. Applied only on the first boot of an empty database; after
# that, change it in the UI or through the API. The API warns at boot while it is the
# old default `fiber`.
FIBER_ADMIN_PASSWORD=
FIBER_ADMIN_USER=admin

# ------------------------------------------------------------------- secrets at rest
# 64 hex chars: openssl rand -hex 32   — keep a backup, there is no recovery path.
# Empty = project and webhook secrets are stored in plaintext and the API warns at boot.
FIBER_SECRETS_KEY=

# ---------------------------------------------------------------------------- network
# Host interface for the published ports. 0.0.0.0 only without a reverse proxy.
FIBER_API_BIND=127.0.0.1
FIBER_UI_BIND=127.0.0.1
# Browser origins allowed to call the API; must include the URL the UI is served from.
FIBER_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# Baked into the UI bundle at build time.
VITE_FIBER_API_URL=http://localhost:18080
# Public base URL of this instance; commit statuses link back to it.
FIBER_PUBLIC_URL=
# Image tag for fiber-api / fiber-agent. Pin an exact version for a reproducible deploy.
FIBER_VERSION=latest

# -------------------------------------------------------------------------- artifacts
# Empty = local filesystem on the fiber_artifacts volume (the default). To use MinIO:
# set FIBER_S3_BUCKET=fiber-artifacts and start the profile —
#   docker compose -f deploy/docker-compose.yml --profile minio up -d
# Switching backends does not move blobs that are already stored.
FIBER_S3_BUCKET=
FIBER_S3_ENDPOINT=http://fiber-minio:9000
FIBER_S3_REGION=us-east-1
# Endpoint that appears in presigned URLs, i.e. what agents and browsers must reach.
# The loopback default only works for an agent on this host.
FIBER_S3_PUBLIC_ENDPOINT=http://127.0.0.1:19000

# ---------------------------------------------------------------------------- GitHub
# Instance-wide fallback for the PR file API and commit statuses. A project secret of
# the same name wins over it. It is instance-wide in the literal sense: any project's
# webhook can reach it, so a project admin who controls their own webhook secret can
# have Fiber spend this token on their behalf. Scope it as narrowly as the two uses
# allow — `repo:status` for statuses, read-only repository contents for the PR file
# list — and prefer a per-project secret for anything private.
FIBER_GITHUB_TOKEN=
# GitHub Enterprise API base; empty = https://api.github.com
FIBER_GITHUB_API_URL=

# -------------------------------------------------------------- retention and limits
# An empty value means the API's own default, given in the comment. Do not put a
# comment on the same line as an empty value: Compose reads the `#` as the value.

# 30 - delete terminal runs older than this many days; 0 disables
FIBER_RETENTION_DAYS=
# 20 - newest terminal runs kept per pipeline whatever their age
FIBER_RETENTION_KEEP_RUNS=
# 100 - runs deleted per tick
FIBER_RETENTION_BATCH=
# 3600 - GC loop period in seconds, floor 60
FIBER_RETENTION_INTERVAL_SECS=
# Terminal durable fibers older than this many days; 0 disables
FIBER_RETENTION_FIBER_DAYS=7
# 24 - artifact objects this old with no database row are deleted; 0 disables
FIBER_RETENTION_ORPHAN_HOURS=
# 50 / 536870912 - artifacts and total bytes one step may store
FIBER_MAX_ARTIFACTS_PER_STEP=
FIBER_MAX_ARTIFACT_BYTES_PER_STEP=
# 10 - live interval_task chains one project may have
FIBER_INTERVAL_MAX_PER_PROJECT=
# Lines stored per step attempt; 0 disables the cap
FIBER_STEP_LOG_MAX_LINES=50000
# 45 - no heartbeat for this long marks an agent offline
FIBER_AGENT_STALE_SECS=
# 60 - per-attempt limit for steps without `timeout_minutes`
FIBER_STEP_TIMEOUT_DEFAULT_MINUTES=
# 5 - extra minutes before the server fails a step the agent did not stop
FIBER_STEP_TIMEOUT_GRACE_MINUTES=
# Let the `http_request` fiber task reach private, loopback and link-local addresses.
FIBER_HTTP_TASK_ALLOW_PRIVATE=0

# --------------------------------------------------------------------- observability
# Bearer token a Prometheus scraper presents to /metrics. Empty = the endpoint is off.
FIBER_METRICS_TOKEN=
# OTLP collector base URL; /v1/traces and /v1/metrics are appended.
OTEL_EXPORTER_OTLP_ENDPOINT=
RUST_LOG=info,fiber_api=info

# --------------------------------------------------------- agent (profile: agent)
# docker compose -f deploy/docker-compose.yml --profile agent up -d fiber-agent
# Mint the token with `fiber agents create --name compose --labels os=linux`.
FIBER_AGENT_TOKEN=
FIBER_AGENT_NAME=compose
FIBER_AGENT_LABELS=os=linux
FIBER_AGENT_CONCURRENCY=2

FROM rust:1.97-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates crates
RUN cargo build --release -p fiber-api

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/fiber-api /usr/local/bin/fiber-api
RUN mkdir -p /data/artifacts
ENV FIBER_ARTIFACTS_DIR=/data/artifacts
EXPOSE 8080
CMD ["fiber-api"]

# Fiber local environment template.
# Copy values you need into your shell, or:  source scripts/dev-env.sh
# For MinIO artifacts:  FIBER_USE_S3=1 source scripts/dev-env.sh

FIBER_DATABASE_URL=postgres://fiber:fiber@127.0.0.1:15432/fiber
FIBER_REDIS_URL=redis://:fiber@127.0.0.1:16379   # Compose Redis password = FIBER_REDIS_PASSWORD (default fiber)
FIBER_LISTEN=0.0.0.0:18080
FIBER_ARTIFACTS_DIR=./data/artifacts
FIBER_ADMIN_USER=admin
FIBER_ADMIN_PASSWORD=fiber
# FIBER_SECRETS_KEY=  # openssl rand -hex 32
# FIBER_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100   # browser origins; * = any
# FIBER_STEP_TIMEOUT_DEFAULT_MINUTES=60   # steps without timeout_minutes
# FIBER_STEP_TIMEOUT_GRACE_MINUTES=5      # server fails a step this long after its timeout

# MinIO (make infra-minio)
# FIBER_USE_S3=1
# FIBER_S3_BUCKET=fiber-artifacts
# FIBER_S3_ENDPOINT=http://127.0.0.1:19000
# FIBER_S3_ACCESS_KEY=fiber
# FIBER_S3_SECRET_KEY=fiberfiber
# FIBER_S3_REGION=us-east-1

FIBER_API_URL=http://127.0.0.1:18080
FIBER_AGENT_USE_DOCKER=false
FIBER_AGENT_NAME=local
FIBER_AGENT_LABELS=os=linux
FIBER_AGENT_CONCURRENCY=1
FIBER_AGENT_WORKSPACE_DIR=./data/workspaces
# FIBER_AGENT_TOKEN=

VITE_FIBER_API_URL=http://127.0.0.1:18080
RUST_LOG=info,fiber_api=info,fiber_agent=info
